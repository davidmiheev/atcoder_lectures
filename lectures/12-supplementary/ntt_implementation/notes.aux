\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The iterative Cooley--Tukey NTT for $n=8$: after the bit-reversal permutation, three stages of butterflies combine entries at distance $1$, $2$, and $4$. Each butterfly maps a pair $(u,v)$ to $(u+\mitomega v,\tmspace  +\thickmuskip {.2777em}u-\mitomega v)$ for the appropriate power $\mitomega $ of the root of unity, so the transform takes $\log _2 n$ stages of $n/2$ butterflies.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ntt_butterfly}{{1}{2}{The iterative Cooley--Tukey NTT for $n=8$: after the bit-reversal permutation, three stages of butterflies combine entries at distance $1$, $2$, and $4$. Each butterfly maps a pair $(u,v)$ to $(u+\omega v,\;u-\omega v)$ for the appropriate power $\omega $ of the root of unity, so the transform takes $\log _2 n$ stages of $n/2$ butterflies}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}NTT versus FFT}{3}{section.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The two transforms side by side.}}{3}{table.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The eight 8th roots of unity in two fields, drawn at the same positions. In both, $\mitomega ^4=-1$ (highlighted: $\mitomega ^0=1$ and $\mitomega ^4=-1$, which is $16$ modulo $17$) and $\mitomega ^{k+4}=-\mitomega ^k$ (for instance $\mitomega ^5=8=-9$ and $\mitomega ^6=4=-13$ modulo $17$); this is the sign flip that lets each butterfly reuse one product twice. The powers of $9$ modulo $17$ are $1,9,13,15,16,8,4,2$, checked by the reference code.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:ntt_roots}{{2}{3}{The eight 8th roots of unity in two fields, drawn at the same positions. In both, $\omega ^4=-1$ (highlighted: $\omega ^0=1$ and $\omega ^4=-1$, which is $16$ modulo $17$) and $\omega ^{k+4}=-\omega ^k$ (for instance $\omega ^5=8=-9$ and $\omega ^6=4=-13$ modulo $17$); this is the sign flip that lets each butterfly reuse one product twice. The powers of $9$ modulo $17$ are $1,9,13,15,16,8,4,2$, checked by the reference code}{figure.caption.3}{}}
