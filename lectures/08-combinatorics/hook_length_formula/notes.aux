\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The boundary path of $\mitlambda =(4,2,1)$ (blue right-steps, brown up-steps), read from the bottom-left to the top-right corner, with the steps numbered from $0$. The up-steps sit at $b_i=\mitlambda _i+m-i$. For a right-step $e$ before the up-step $b_i$, the number $b_i-e$ is the hook length of the cell in row $i$ and in the column of that right-step.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:hl_boundary}{{4}{7}{The boundary path of $\lambda =(4,2,1)$ (blue right-steps, brown up-steps), read from the bottom-left to the top-right corner, with the steps numbered from $0$. The up-steps sit at $b_i=\lambda _i+m-i$. For a right-step $e$ before the up-step $b_i$, the number $b_i-e$ is the hook length of the cell in row $i$ and in the column of that right-step}{figure.caption.4}{}}
