\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Tableaux as moving walkers}{5}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two walkers (blue and brown) from positions $(1,0)$ to $(3,1)$ in three unit moves, for $\mitlambda =(2,1)$. Panels (a) and (b) are the $f^{(2,1)}=2$ collision-free walks, i.e.\ the two standard tableaux. In (c) the walkers meet at time $1$; exchanging what they do afterwards gives the dashed walk, which ends at $(1,3)$ instead of $(3,1)$: the endpoints are swapped, so the two walks carry opposite signs and cancel.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:hl_walkers}{{3}{5}{Two walkers (blue and brown) from positions $(1,0)$ to $(3,1)$ in three unit moves, for $\lambda =(2,1)$. Panels (a) and (b) are the $f^{(2,1)}=2$ collision-free walks, i.e.\ the two standard tableaux. In (c) the walkers meet at time $1$; exchanging what they do afterwards gives the dashed walk, which ends at $(1,3)$ instead of $(3,1)$: the endpoints are swapped, so the two walks carry opposite signs and cancel}{figure.caption.3}{}}
