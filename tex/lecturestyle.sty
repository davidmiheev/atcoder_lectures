% lecturestyle.sty
% Shared visual style for the "Competitive Programming Lecture Notes" series.
% This is an original design (clean academic lecture-note look: title band,
% theorem/definition/example boxes, syntax-highlighted code listings,
% consistent header/footer). It does not copy any third party's proprietary
% layout or branding.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lecturestyle}[2026/01/01 Lecture note style]

\RequirePackage{fontspec}
% DejaVu Serif ships no italic face, so emphasis uses a slanted upright
% (otherwise \emph silently renders upright and LaTeX warns on every build).
\setmainfont{DejaVu Serif}[
  ItalicFont={DejaVu Serif}, ItalicFeatures={FakeSlant=0.2},
  BoldItalicFont={DejaVu Serif Bold}, BoldItalicFeatures={FakeSlant=0.2}]
\setsansfont{DejaVu Sans}
\setmonofont{DejaVu Sans Mono}[Scale=0.88]
\RequirePackage[a4paper,margin=2.2cm]{geometry}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{unicode-math}
\setmathfont{TeX Gyre Termes Math}
\RequirePackage{mathtools}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{hyperref}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage[font={small,sf},labelfont=bf,labelsep=period,margin=1em]{caption}
\RequirePackage{xurl} % lets long URLs break at any character instead of overflowing the margin
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,shapes.geometric,
  decorations.pathreplacing,backgrounds,matrix}

% ---- palette (original, not a copy of any third-party brand) ----
\definecolor{lectureink}{HTML}{1B2733}
\definecolor{lectureaccent}{HTML}{2C5F8A}
\definecolor{lecturebg}{HTML}{F4F7FA}
\definecolor{lecturewarn}{HTML}{8A4B2C}
\definecolor{codebg}{HTML}{F7F7F9}
\definecolor{coderule}{HTML}{D8DEE4}

\hypersetup{
  colorlinks=true,
  linkcolor=lectureaccent,
  urlcolor=lectureaccent,
  citecolor=lectureaccent
}

% ---- title band ----
\newcommand{\lecturetitleband}[3]{%
  % #1 = category  #2 = title  #3 = difficulty (1-9)
  \begin{tcolorbox}[colback=lectureaccent,colframe=lectureaccent,
      sharp corners,boxrule=0pt,left=10pt,right=10pt,top=8pt,bottom=8pt]
    {\color{white}\small\sffamily #1 \hfill Difficulty: #3/9}\\[4pt]
    {\color{white}\LARGE\sffamily\bfseries #2}
  \end{tcolorbox}
  \vspace{2pt}
  {\small\color{lectureink!70} Topic based on the AtCoder Algorithm Lectures
   series index (\url{https://info.atcoder.jp/entry/algorithm_lectures/index}).
   This document is an independent, original set of notes covering the same
   subject and is not a translation of, or affiliated with, AtCoder Inc.}
  \vspace{6pt}
  \hrule
  \vspace{10pt}
}

% Variant for original supplementary lectures that are NOT drawn from the
% AtCoder Algorithm Lectures index (e.g. filling in prerequisite material
% another lecture assumes). Same visual style, accurate description.
\newcommand{\lecturetitlebandsupplement}[3]{%
  % #1 = category  #2 = title  #3 = difficulty (1-9)
  \begin{tcolorbox}[colback=lectureaccent,colframe=lectureaccent,
      sharp corners,boxrule=0pt,left=10pt,right=10pt,top=8pt,bottom=8pt]
    {\color{white}\small\sffamily #1 \hfill Difficulty: #3/9}\\[4pt]
    {\color{white}\LARGE\sffamily\bfseries #2}
  \end{tcolorbox}
  \vspace{2pt}
  {\small\color{lectureink!70} An original supplementary lecture in this
   series, not itself drawn from the AtCoder Algorithm Lectures index
   (\url{https://info.atcoder.jp/entry/algorithm_lectures/index}), added
   to cover prerequisite material another lecture in the series assumes.}
  \vspace{6pt}
  \hrule
  \vspace{10pt}
}

% ---- shared TikZ styles for the illustrations ----
\tikzset{
  lnode/.style={draw=lectureaccent,fill=lecturebg,rounded corners=2pt,
    minimum height=6mm,inner sep=2.5pt,font=\small\sffamily,align=center},
  lcell/.style={draw=lectureink!60,minimum width=8mm,minimum height=7mm,
    inner sep=0pt,font=\small\sffamily,anchor=center},
  lhi/.style={fill=lectureaccent!28},
  lhi2/.style={fill=lecturewarn!28},
  lgray/.style={fill=lectureink!8},
  larrow/.style={-{Stealth[length=2.2mm]},thick,draw=lectureink!80},
  lthin/.style={-{Stealth[length=1.8mm]},draw=lectureink!70},
  llabel/.style={font=\footnotesize\sffamily,text=lectureink!85},
  lvert/.style={circle,draw=lectureink!80,fill=white,minimum size=6.5mm,
    inner sep=0pt,font=\small\sffamily},
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.2pt}
\fancyfoot[C]{\thepage}
\fancyfoot[L]{\small\color{lectureink!60}Competitive Programming Lecture Notes}

\titleformat{\section}{\Large\sffamily\bfseries\color{lectureaccent}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\large\sffamily\bfseries\color{lectureink}}{\thesubsection}{0.6em}{}

% ---- theorem-like boxes ----
% "Theorem --- Remainder Theorem" when an optional name is given, plain "Theorem" otherwise.
\newcommand{\boxtitle}[2]{#1\ifx\relax#2\relax\else\,---\,#2\fi}

\newtcolorbox{definitionbox}[1][]{
  enhanced, breakable, colback=lecturebg, colframe=lectureaccent,
  boxrule=0.6pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries, title={\boxtitle{Definition}{#1}}
}
\newtcolorbox{theorembox}[1][]{
  enhanced, breakable, colback=lecturebg, colframe=lectureink,
  boxrule=0.6pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries, title={\boxtitle{Theorem}{#1}}
}
\newtcolorbox{examplebox}[1][]{
  enhanced, breakable, colback=white, colframe=coderule,
  boxrule=0.6pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries, coltitle=lectureink, title={\boxtitle{Example}{#1}}
}
\newtcolorbox{notebox}[1][]{
  enhanced, breakable, colback=white, colframe=lecturewarn,
  boxrule=0.6pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries, coltitle=white, title={\boxtitle{Note}{#1}}
}

% ---- code listings ----
\lstdefinestyle{lecturecode}{
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{lectureaccent}\bfseries,
  commentstyle=\color{lectureink!50}\itshape,
  stringstyle=\color{lecturewarn},
  numbers=left,
  numberstyle=\tiny\color{lectureink!40},
  frame=single,
  rulecolor=\color{coderule},
  framesep=6pt,
  breaklines=true,
  showstringspaces=false,
  tabsize=2,
  xleftmargin=1em
}
\lstset{style=lecturecode}

% Prints only the part of an example file between its PDFBEGIN and PDFEND
% marker comments (the core algorithm); the randomized test harness that
% follows PDFEND stays in the repository file but out of the PDF.
\newcommand{\corelisting}[2]{%
  \lstinputlisting[language=#1,linerange={PDFBEGIN-PDFEND},includerangemarker=false]{#2}}
\newcommand{\codenote}{%
  {\small\color{lectureink!70}The listings show the core algorithm only. The
   complete files --- including the randomized cross-checks against brute
   force that produced the results quoted below --- are \texttt{example.rs}
   and \texttt{example.py} in this lecture's folder of the repository.\par}
  \vspace{4pt}}

\lstdefinelanguage{Rust}{
  keywords={fn,let,mut,if,else,match,for,while,loop,struct,enum,impl,trait,pub,use,mod,return,break,continue,self,Self,as,in,ref,move,unsafe,where,const,static,dyn,async,await},
  keywordstyle=\color{lectureaccent}\bfseries,
  sensitive=true,
  comment=[l]{//},
  morecomment=[s]{/*}{*/},
  string=[b]"
}

\endinput
